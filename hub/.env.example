# Kraken Hub configuration

# Where ship stacks are written. Each ship gets a subdirectory here with its own
# docker-compose.yml + .env + data/ + steam-home/ + backups/.
KRAKEN_FLEET_ROOT=./fleet

# Path to the Kraken / Windrose docker-compose template. Defaults to the repo
# root (one level up from hub/) which is what you want when running from a
# clone of github.com/C9RE/Kraken.
# KRAKEN_TEMPLATE=/path/to/Kraken

# HTTP server (production only)
PORT=8783
HOST=0.0.0.0
